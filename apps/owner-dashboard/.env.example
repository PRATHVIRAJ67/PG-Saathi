# Supabase project (publishable/anon key only — NEVER the service-role key).
# Leave both empty to run in demo mode (PGlite in your browser, sample data).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Production builds refuse to start without Supabase unless this is "true"
# (useful for a public demo deployment).
VITE_ENABLE_DEMO=false
