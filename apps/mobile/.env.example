# Supabase publishable (anon) key only. Without these the app runs a
# read-only demo built from a recorded snapshot of the sample workspace.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# PG Sathi payments service (apps/resident-api). Enables "Pay online" when
# the PG has connected their Razorpay account. Public URL, not a secret.
EXPO_PUBLIC_RESIDENT_API_URL=
