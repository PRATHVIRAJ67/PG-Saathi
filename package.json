{
  "name": "pg-saas",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-tenant PG (paying guest) management SaaS — owner web dashboard, owner mobile app and platform admin, on Supabase.",
  "workspaces": [
    "packages/*",
    "supabase",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev:owner": "npm run dev -w @pg/owner-dashboard",
    "dev:admin": "npm run dev -w @pg/super-admin",
    "dev:mobile": "npm run start -w @pg/mobile",
    "build": "npm run build -w @pg/owner-dashboard && npm run build -w @pg/super-admin && npm run export:android -w @pg/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run --project db",
    "test:watch": "vitest",
    "demo:snapshot": "tsx scripts/build-demo-snapshot.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "type": "module"
}
