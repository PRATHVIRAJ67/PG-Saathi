# ---------------------------------------------------------------------------
# PG SaaS — environment variables
# Copy the relevant block into apps/<app>/.env (each app reads its own file).
# Only PUBLISHABLE (anon) keys belong here. The service-role key and any
# payment-provider secrets go into Supabase function secrets, never into
# VITE_* / EXPO_PUBLIC_* variables (those are bundled into client code).
# Leave the Supabase values empty to run each app in demo mode.
# ---------------------------------------------------------------------------

# apps/owner-dashboard/.env  and  apps/super-admin/.env
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Production builds refuse to start without Supabase unless this is "true".
VITE_ENABLE_DEMO=false

# apps/mobile/.env
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
